{
  "datasets": [
    {
      "name": "a457c717",
      "displayName": "Preco_minimo",
      "queryLines": [
        "SELECT\r\n",
        "    round(valor_brl,2) AS min_price_brl,\r\n",
        "    timestamp AS min_timestamp\r\n",
        "    FROM pipeline_api_bitcoin.bitcoin_data.bitcoin_data\r\n",
        "    WHERE criptomoeda = 'BTC'\r\n",
        "    ORDER BY valor_brl ASC, timestamp DESC\r\n",
        "    LIMIT 1"
      ]
    },
    {
      "name": "77a0b427",
      "displayName": "preco_maximo",
      "queryLines": [
        "SELECT\r\n",
        "    round(valor_brl,2) AS max_price_brl,\r\n",
        "    timestamp AS max_timestamp\r\n",
        "    FROM pipeline_api_bitcoin.bitcoin_data.bitcoin_data\r\n",
        "    WHERE criptomoeda = 'BTC'\r\n",
        "    ORDER BY valor_brl DESC, timestamp DESC\r\n",
        "    LIMIT 1"
      ]
    },
    {
      "name": "4269a270",
      "displayName": "ultimo_preco",
      "queryLines": [
        "SELECT\r\n",
        "valor_brl AS last_price_brl,\r\n",
        "timestamp AS last_timestamp\r\n",
        "FROM pipeline_api_bitcoin.bitcoin_data.bitcoin_data\r\n",
        "WHERE criptomoeda = 'BTC'\r\n",
        "ORDER BY timestamp DESC\r\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "f8554bd4",
      "displayName": "dados_bitcoin",
      "queryLines": [
        "SELECT\r\n",
        " timestamp,\r\n",
        " valor_brl\r\n",
        " FROM pipeline_api_bitcoin.bitcoin_data.bitcoin_data\r\n",
        " WHERE criptomoeda = 'BTC'\r\n",
        " ORDER BY timestamp"
      ]
    }
